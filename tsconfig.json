{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@wordpress/scripts/config/tsconfig.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"]
}
